{
  "name": "lightmap-studio",
  "version": "0.1.0",
  "description": "Engine-agnostic unwrapping and lightmap baking studio built on xatlas-wasm and lightmapper-wasm.",
  "license": "Unlicense",
  "author": "alexander.klingenbeck@gmx.de",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mode777/lightmap-studio.git"
  },
  "homepage": "https://github.com/mode777/lightmap-studio#readme",
  "bugs": {
    "url": "https://github.com/mode777/lightmap-studio/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "lightmap",
    "lightmapping",
    "baking",
    "webgl2",
    "webassembly",
    "wasm",
    "xatlas",
    "uv-unwrap"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/unit.test.mjs test/unwrap.test.mjs test/loader.test.mjs test/import-boundary.test.mjs",
    "test:headless": "node scripts/headless-test.mjs",
    "test:consumer": "node scripts/consumer-test.mjs",
    "test:pack": "node scripts/pack-test.mjs"
  },
  "dependencies": {
    "lightmapper-wasm": "^0.2.0",
    "xatlas-wasm": "^0.2.0"
  },
  "devDependencies": {
    "puppeteer-core": "^24.43.1",
    "typescript": "^5.8.2",
    "vite": "6.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
